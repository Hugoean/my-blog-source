<div class="post-list">
  <div class="section-label">// LATEST POSTS</div>
  <% page.posts.each(function(post) { %>
  <article class="post-card">
    <div class="post-meta">
      <span class="post-date"><%= date(post.date, 'YYYY-MM-DD') %></span>
      <% if(post.tags && post.tags.length) { %>
        <% post.tags.each(function(tag) { %>
          <span class="tag"># <%= tag.name %></span>
        <% }) %>
      <% } %>
    </div>
    <h2 class="post-title">
      <a href="<%- url_for(post.path) %>"><%= post.title %></a>
    </h2>
    <p class="post-excerpt"><%= post.excerpt ? strip_html(post.excerpt) : strip_html(post.content).substring(0,120) %>...</p>
    <a class="read-more" href="<%- url_for(post.path) %>">READ MORE ›</a>
  </article>
  <% }) %>
  <article class="post-card">
    <div class="post-meta">
      <span class="post-date">2026-06-05</span>
      <span class="tag"># 论文阅读</span>
      <span class="tag"># 数据工程</span>
      <span class="tag"># Paper</span>
    </div>
    <h2 class="post-title">
      <a href="/papers-reader/">大模型论文阅读地图 · 开源版</a>
    </h2>
    <p class="post-excerpt">已发布 Dolma、FineWeb、DataComp-LM 三篇中英双语论文阅读笔记，包含正文、图片和每张图下方的中文解释。</p>
    <a class="read-more" href="/papers-reader/">READ MORE ›</a>
  </article>
</div>
